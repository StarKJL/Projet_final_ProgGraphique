<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjetFinal.Vues.AjouterClient"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjetFinal.Vues"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel
    Width="400"
    Height="450"
    Margin="50"
    Padding="20"
    CornerRadius="20"
    Background="LightBlue">
        <TextBlock HorizontalAlignment="Center" FontSize="25">Ajout de client</TextBlock>

        <TextBox x:Name="tbxNom" Header="Nom complet"/>
        <TextBlock Foreground="Red" x:Name="tblErrNom"/>

        <TextBox x:Name="tbxAdr" Header="Adresse"/>
        <TextBlock Foreground="Red" x:Name="tblErrAdr"/>

        <TextBox x:Name="tbxTel" Header="Numéro de téléphone"/>
        <TextBlock Foreground="Red" x:Name="tblErrTel"/>

        <TextBox x:Name="tbxMail" Header="Email"/>
        <TextBlock Foreground="Red" x:Name="tblErrMail"/>

        <Button Content="Soumettre" x:Name="btnSubmit" Click="btnSubmit_Click"/>
    </StackPanel>
</Page>
