<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="ProjetFinal.Vues.DetailsProjet"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ProjetFinal.Classe"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="500"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid
            Grid.Column="0"
            CornerRadius="20"
            Padding="50"
            Margin="5"
            Background="LightBlue"
            RowSpacing="50"> 
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="tblClient" Grid.Row="0" FontSize="15"/>
            <TextBlock Grid.Row="0" x:Name="tblStatut" HorizontalAlignment="Right" FontSize="15"/>

            <TextBlock Grid.Row="1" x:Name="tblTitre" HorizontalAlignment="Center" TextWrapping="Wrap" FontSize="40"/>

            <TextBlock Grid.Row="2" x:Name="tblDesc" Margin="10" HorizontalAlignment="Center" TextWrapping="Wrap" FontSize="20"/>

            <TextBlock Grid.Row="3" x:Name="tblDate" FontSize="20"/>
            <TextBlock Grid.Row="4" x:Name="tblBudget" FontSize="20"/>
            <TextBlock Grid.Row="5" x:Name="tblSal" FontSize="20"/>
        </Grid>

        <StackPanel 
            Grid.Column="1">
                <TextBlock VerticalAlignment="Center"
                           Text="Employés"
                           Margin="160,10,10,10"
                           FontSize="30"/>
                <StackPanel Orientation="Horizontal" 
                Margin="30,10,10,10"
                Padding="5"
                Height="40">
                <TextBlock VerticalAlignment="Center" Text="Matricule" Width="100"/>
                <TextBlock VerticalAlignment="Center" Text="Prénom" Width="100"/>
                <TextBlock VerticalAlignment="Center" Text="Nom" Width="100"/>

                <TextBlock VerticalAlignment="Center" Text="Salaire"/>
            </StackPanel>
            <ListView 
                x:Name="lvEmployes"
                SelectionChanged="lvEmployes_SelectionChanged">  
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:EmployeProjet">
                        <StackPanel Orientation="Horizontal" 
                                    Width="400"
                                    HorizontalAlignment="Left"
                                    Background="LightBlue"
                                    Margin="10"
                                    Padding="5"
                                    CornerRadius="10"
                                    Height="40">    
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind MatriculeId}" Width="100"/>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind PrenomEmploye}" Width="100"/>
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind NomEmploye}" Width="100"/>

                            <TextBlock VerticalAlignment="Center">
                            <Run Text="{x:Bind Salaire}"/>
                            <Run Text="$"/>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>
        
    </Grid>
</Page>
